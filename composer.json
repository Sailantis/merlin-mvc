{
  "name": "sailantis/azera-framework",
  "description": "A lightweight, fast PHP framework for building modern web and cli applications. Azera combines the best ideas from frameworks like Phalcon, CodeIgniter, Laravel and Twig into a minimal yet powerful toolkit.",
  "type": "library",
  "repositories": [
    {
      "type": "path",
      "url": "../clarity-engine"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*",
    "ext-pdo": "*",

    "sailantis/clarity-engine": "dev-main",
    "psr/log": "3.0",
    "psr/event-dispatcher": "1.0",
    "psr/simple-cache": "3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpdocumentor/reflection-docblock": "^6.0",
    "twig/twig": "^3.8",
    "league/plates": "^3.6",
    "illuminate/view": "^10.49"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Azera\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Azera\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
